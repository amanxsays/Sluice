# Reference for Render / other backend hosts. Spring does not load this file automatically.
# Add these values to your host's environment settings; keep real secrets out of Git.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_DIRECT_HOST:5432/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_ROLE
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD
SLUICE_CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND.netlify.app
DB_POOL_SIZE=5

# Render sets PORT automatically. A local Docker deployment can use PORT=8080.
PORT=10000
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65.0
SLUICE_WORKER_COUNT=2
SLUICE_LAB_ENABLED=true
SLUICE_SIMULATION_ENABLED=true

# Optional: use a separately hosted mock service instead of the built-in endpoint.
# SLUICE_MOCK_UPSTREAM_URL=https://YOUR_MOCK_HOST/simulate
