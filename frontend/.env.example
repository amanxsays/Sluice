# Local development: Vite proxies /api to the backend.
VITE_API_BASE_URL=/api

# For Netlify / other static hosts, set the public backend origin in build settings:
# VITE_API_BASE_URL=https://YOUR_BACKEND.onrender.com
# Do not append /api: backend routes are /jobs and /tests/runs.
# Restart Vite locally, or rebuild/redeploy the hosted frontend after changing it.
# This value is public. Database credentials belong only on the backend host.
